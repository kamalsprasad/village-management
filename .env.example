# Appwrite Configuration
# Copy this file to .env and fill in your actual values
# Note: Vite requires environment variables to be prefixed with VITE_

# Public base URL of this Village Management deployment.
# Used to build the password-recovery redirect link sent by Appwrite.
VITE_APP_PUBLIC_URL=http://localhost:9000

# Appwrite API Endpoint
# For Appwrite Cloud: https://cloud.appwrite.io/v1
# For self-hosted: https://your-domain.com/v1
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID
# Get this from your Appwrite console
VITE_APPWRITE_PROJECT_ID=your-project-id-here

# Appwrite API Key (for server-side setup script only)
# Create an API key in Appwrite Console with Database permissions
# This is NOT exposed to the client and should be kept secure
VITE_APPWRITE_API_KEY=your-api-key-here

# Appwrite Function ID for checking if users exist
# Get this from Appwrite Console after deploying the checkUsersExist function
# See appwrite_setup/FUNCTION_DEPLOYMENT.md for deployment instructions
VITE_APPWRITE_FUNCTION_CHECK_USERS="checkUsersExist"

# Appwrite Function ID for wiping all data (sample data mode)
# Get this from Appwrite Console after deploying the wipeAllData function
# See appwrite_setup/FUNCTION_DEPLOYMENT.md for deployment instructions
VITE_APPWRITE_FUNCTION_WIPE_DATA="wipeAllData"

# Appwrite Function ID for seeding all sample data
# Get this from Appwrite Console after deploying the seedAllData function
VITE_APPWRITE_FUNCTION_SEED_DATA="seedAllData"

# Story 5.4: Appwrite Function ID for the admin storage usage report
# Get this from Appwrite Console after deploying the storageUsageReport function
VITE_APPWRITE_FUNCTION_STORAGE_REPORT="storageUsageReport"

# Story 5.12: Appwrite Function ID for admin-driven user management
# (create/update/deactivate/reactivate user, team sync, audit logging).
# Get this from Appwrite Console after deploying the "User Management" function
# See appwrite_setup/FUNCTION_DEPLOYMENT.md for deployment instructions
VITE_APPWRITE_FUNCTION_USER_MANAGEMENT="userManagement"

# Story 5.10c: Appwrite Function ID for role-targeted notification delivery.
# Get this from Appwrite Console after deploying the "Create Notification" function.
VITE_APPWRITE_FUNCTION_CREATE_NOTIFICATION="createNotification"

# Database ID
VITE_APPWRITE_DATABASE_ID=villageDB

# Table IDs
VITE_APPWRITE_TABLE_USERS=users
VITE_APPWRITE_TABLE_RESIDENTS=residents
VITE_APPWRITE_TABLE_HOUSEHOLDS=households
VITE_APPWRITE_TABLE_ROLES=roles
VITE_APPWRITE_TABLE_VILLAGE_SETTINGS=village_settings
VITE_APPWRITE_TABLE_INVENTORY=inventory
VITE_APPWRITE_TABLE_VILLAGE_EVENTS=village_events

# Story 5.10c: Notifications tables
VITE_APPWRITE_TABLE_NOTIFICATIONS=notifications
VITE_APPWRITE_TABLE_NOTIFICATION_READS=notification_reads

# Story 5.3: Cloud Storage — personal files metadata table and bucket
VITE_APPWRITE_TABLE_FILE_METADATA=file_metadata
VITE_APPWRITE_BUCKET_PERSONAL_FILES=personal_files

# Story 5.4: Cloud Storage — shared files bucket (Finance/Farm/School/Village
# Documents/Admin Only shared folders; same file_metadata table as Story 5.3)
VITE_APPWRITE_BUCKET_SHARED_FILES=shared_files

# Server-side equivalents (server/.env, no VITE_ prefix)
APPWRITE_TABLE_FILE_METADATA=file_metadata
APPWRITE_BUCKET_PERSONAL_FILES=personal_files
APPWRITE_BUCKET_SHARED_FILES=shared_files
