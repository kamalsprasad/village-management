{
  "name": "village-management-system",
  "version": "1.0.0-beta",
  "description": "The Sustainable Model Village Management System is an open-source web platform designed to transform rural African villages from memory-based, trial-and-error operations into data-driven, systematically managed communities.",
  "productName": "Village Management System",
  "author": "Kamal S. Prasad",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "start-server-and-test dev http-get://localhost:9000 'cypress run'",
    "test:e2e:open": "start-server-and-test dev http-get://localhost:9000 'cypress open'",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "setup:appwrite": "node server/scripts/setup-appwrite.js",
    "seed:roles": "node server/scripts/seed-roles.js",
    "create:admin": "node scripts/setup/create-admin.js",
    "seed:soil-types": "node server/scripts/seed-soil-types.js",
    "seed:crops": "node server/scripts/seed-crops.js",
    "seed:settings": "node server/scripts/seed-village-settings.js",
    "seed:sample": "node server/scripts/seed-sample-data.js",
    "diagnose:schema": "node server/scripts/diagnose-schema.js",
    "rebuild:inventory": "node server/scripts/rebuild-inventory-table.js"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "appwrite": "^21.5.0",
    "axios": "^1.13.3",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^4.2.1",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "pinia": "^3.0.4",
    "quasar": "^2.18.6",
    "vue": "^3.5.27",
    "vue-cal": "^5.0.1-rc.33",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@quasar/app-vite": "^2.4.0",
    "@testing-library/vue": "^8.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.23",
    "cypress": "^15.20.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.1.0",
    "jsdom": "^29.1.1",
    "node-appwrite": "^21.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.12",
    "vite-plugin-checker": "^0.12.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.2.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
